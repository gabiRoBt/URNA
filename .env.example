# Copy this file to `.env` and fill in both values.
# `.env` is gitignored — never commit it.

# An RPC endpoint for Sepolia.
#
# A free Alchemy or Infura key is more reliable than a public endpoint,
# especially for the repeated calls a draw makes. A public one works too:
#   https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=

# Private key of the deploying account, with or without the 0x prefix.
#
# Use a wallet created solely for this testnet work. Never put a key here that
# holds anything on mainnet: this file sits in plaintext on disk, and a key
# pasted once tends to stay pasted.
DEPLOYER_PRIVATE_KEY=
